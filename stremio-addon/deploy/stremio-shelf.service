[Unit]
Description=Shelf addon for Stremio
After=network-online.target
Requires=stremio-shelf.socket
After=stremio-shelf.socket

[Service]
Type=simple
User=arnav
Group=arnav
WorkingDirectory=/home/arnav/stremio-shelf
Environment=SHELF_ROOT=/media/Movies_and_Shows
Environment=SHELF_IDLE_SECONDS=1800
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/arnav/stremio-shelf/.venv/bin/uvicorn app:app --fd 3 --proxy-headers
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
Also=stremio-shelf.socket
WantedBy=multi-user.target
