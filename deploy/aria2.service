[Unit]
Description=aria2 download engine (RPC for Shelf)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=arnav
Group=arnav
ExecStart=/usr/bin/aria2c --conf-path=/home/arnav/.config/aria2/aria2.conf
Restart=on-failure
RestartSec=5
# downloads that are open when the daemon stops are picked up again from the session file
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
